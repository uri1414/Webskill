# Rosa & Co. CPA — client portal environment variables.
# Copy to `.env.local` for local dev; set the same three in Netlify.

# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase ANON / publishable key (public — safe in the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# This app's own URL (auth email redirects). Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
